plugin -i slang
read_slang --best-effort-hierarchy ibsm.sv fifo.sv mkreq.sv mkwe.sv ib.sv arb.sv cbsel.sv ackor.sv cb.sv sw.sv
# Without the yosys-slang plugin, replace the two lines above with:
# read_verilog -sv ibsm.sv fifo.sv mkreq.sv mkwe.sv ib.sv arb.sv cbsel.sv ackor.sv cb.sv sw.sv
proc
hierarchy -check -top sw
synth -auto-top
write_verilog synth.v
dfflibmap -liberty ../osu018_stdcells.lib
abc -D 5000 -liberty ../osu018_stdcells.lib
stat -liberty ../osu018_stdcells.lib
write_verilog gate.v
select sw
#show -viewer gvedit
