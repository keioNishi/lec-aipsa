plugin -i slang
read_slang updown_counter.sv
# Without the yosys-slang plugin, replace the two lines above with:
# read_verilog -sv updown_counter.sv
proc
hierarchy -check -top updown_counter
synth -auto-top
write_verilog synth.v
dfflibmap -liberty ../osu018_stdcells.lib
abc -D 5000 -liberty ../osu018_stdcells.lib
stat -liberty ../osu018_stdcells.lib
write_verilog gate.v
select updown_counter
#show -viewer gvedit
